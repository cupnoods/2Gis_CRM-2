# Supabase project used by this deployment. Public browser credentials only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY is supported for existing deployments.

# Optional map tiles (browser key restricted to your domains).
NEXT_PUBLIC_2GIS_API_KEY=

# Optional business search. Server-only Places API key; never prefix NEXT_PUBLIC_.
GIS_PLACES_API_KEY=
